<?xml version="1.0"?>
<!-- MoveIt-side wrapper of the fabricator4 cell, the counterpart of
     ../multi_robot_cell.urdf.xacro: the description package's cell plus a single
     mock_components FakeSystem over the 28 rail/arm joints (no tools). move_group and the
     TAMP generators load this file; ros2_control_node loads the description's
     urdf/fabricator4_cell.urdf.xacro directly (multi_robot_control.launch.py). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fabricator4_cell">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <xacro:include filename="$(find four_robot_cell)/urdf/fabricator4_cell.urdf.xacro" />
    <xacro:include filename="fabricator4_cell.ros2_control.xacro" />

    <xacro:fabricator4_cell_ros2_control name="FakeSystem"
        initial_positions_file="$(arg initial_positions_file)"
        robots="${list(layout['robots'].keys())}" />
</robot>

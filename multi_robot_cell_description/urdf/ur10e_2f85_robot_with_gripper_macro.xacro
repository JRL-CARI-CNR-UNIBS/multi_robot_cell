<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro" />
  <xacro:include filename="$(find ur_description)/urdf/ros2_control_mock_hardware.xacro" />
  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_2f_85_macro.urdf.xacro" />
  <xacro:include filename="$(find multi_robot_cell_description)/urdf/torch_macro.xacro" />

  <xacro:macro name="ur10e_2f85_robot_with_gripper" params="
    prefix
    parent
    *origin
    ur_name:=ur10e
    include_ros2_control:=true
    use_fake_hardware:=true
    robotiq_com_port:=/dev/robotiq
    tool:=gripper
    torch_tcp_xyz:='0 0 0'
    torch_tcp_rpy:='0 0 0'
    arm_initial_positions:=${None}">

    <!-- tool: "gripper" = Robotiq 2F-85 on tool0 (with its ros2_control hardware);
         "torch" = MIG torch (torch_macro.xacro) on tool0, no gripper hardware.
         arm_initial_positions: optional dict {shoulder_pan_joint: .., ...} for the
         mock hardware's initial state; None keeps ur_description's default. -->
    <xacro:unless value="${tool in ('gripper', 'torch')}">
      <xacro:element xacro:name="${xacro.fatal('ur10e_2f85_robot_with_gripper: unknown tool ' + str(tool))}" />
    </xacro:unless>

    <xacro:ur_robot
      name="${ur_name}"
      tf_prefix="${prefix}"
      parent="${parent}"
      joint_limits_parameters_file="$(find ur_description)/config/ur10e/joint_limits.yaml"
      kinematics_parameters_file="$(find ur_description)/config/ur10e/default_kinematics.yaml"
      physical_parameters_file="$(find ur_description)/config/ur10e/physical_parameters.yaml"
      visual_parameters_file="$(find ur_description)/config/ur10e/visual_parameters.yaml">
      <xacro:insert_block name="origin" />
    </xacro:ur_robot>

    <xacro:if value="${tool == 'gripper'}">
    <xacro:robotiq_gripper
      name="${prefix}RobotiqGripperHardwareInterface"
      prefix="${prefix}"
      parent="${prefix}tool0"
      use_fake_hardware="${use_fake_hardware}"
      com_port="${robotiq_com_port}">
      <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:robotiq_gripper>
    </xacro:if>
    <xacro:if value="${tool == 'torch'}">
      <xacro:mig_torch prefix="${prefix}" parent="${prefix}tool0"
        tcp_xyz="${torch_tcp_xyz}" tcp_rpy="${torch_tcp_rpy}" />
    </xacro:if>
    <xacro:if value="${include_ros2_control}">
      <xacro:if value="${arm_initial_positions is None}">
        <xacro:ur_ros2_control name="${prefix}${ur_name}" tf_prefix="${prefix}" />
      </xacro:if>
      <xacro:unless value="${arm_initial_positions is None}">
        <xacro:ur_ros2_control name="${prefix}${ur_name}" tf_prefix="${prefix}"
          initial_positions="${arm_initial_positions}" />
      </xacro:unless>
    </xacro:if>

    <ros2_control name="${prefix}linear_guide_hw" type="system">
      <!-- Plugins -->
      <hardware>
        <xacro:if value="${use_fake_hardware}">
            <plugin>mock_components/GenericSystem</plugin>
            <param name="mock_sensor_commands">true</param>
        </xacro:if>
      </hardware>
      <joint name="${prefix}linear_guide_joint">
          <command_interface name="position" />
          <command_interface name="velocity" />

          <state_interface name="position">
              <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity"/>
      </joint>

    </ros2_control>


  </xacro:macro>

</robot>

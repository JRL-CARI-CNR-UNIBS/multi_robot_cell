<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- MIG welding torch (collision sensor + swan neck + nozzle), rigidly mounted on the
       flange. Meshes and the sphere chain are generated by
       thesis_material_tamp/tools/make_torch.py into meshes/torch/; the mesh origin is
       the tool0 frame (z out of the flange).

       ${prefix}torch_link : the torch body, fixed to ${parent} (tool0) at identity. Drawn as
                             five visual_<part>.stl, one material each (make_torch.py's
                             VISUAL_PARTS; visual.stl is their union, kept for other users);
                             collided as collision.stl.
       ${prefix}torch_tcp  : the wire tip (TCP), z along the wire, fixed to torch_link at
                             tcp_xyz / tcp_rpy (space-separated strings, in tool0). The
                             cell passes the values from its layout YAML's `torch:` block. -->
  <xacro:macro name="mig_torch" params="prefix parent tcp_xyz tcp_rpy">

    <link name="${prefix}torch_link">
      <!-- flange, bolts, collision sensor, neck holder, clamp -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://multi_robot_cell_description/meshes/torch/visual_body.stl" />
        </geometry>
        <material name="torch_body_dark_grey">
          <color rgba="0.16 0.16 0.17 1.0" />
        </material>
      </visual>
      <!-- swan neck and hex nut -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://multi_robot_cell_description/meshes/torch/visual_neck.stl" />
        </geometry>
        <material name="torch_neck_black">
          <color rgba="0.05 0.05 0.05 1.0" />
        </material>
      </visual>
      <!-- insulating ring -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://multi_robot_cell_description/meshes/torch/visual_insulator.stl" />
        </geometry>
        <material name="torch_insulator_beige">
          <color rgba="0.90 0.86 0.74 1.0" />
        </material>
      </visual>
      <!-- gas diffuser, conical nozzle, contact tip -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://multi_robot_cell_description/meshes/torch/visual_nozzle.stl" />
        </geometry>
        <material name="torch_nozzle_copper">
          <color rgba="0.72 0.45 0.20 1.0" />
        </material>
      </visual>
      <!-- welding wire (stickout to the TCP) -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://multi_robot_cell_description/meshes/torch/visual_wire.stl" />
        </geometry>
        <material name="torch_wire_steel">
          <color rgba="0.62 0.64 0.66 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://multi_robot_cell_description/meshes/torch/collision.stl" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.02 0 0.12" rpy="0 0 0" />
        <mass value="1.5" />
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.002" />
      </inertial>
    </link>

    <joint name="${prefix}torch_joint" type="fixed">
      <parent link="${parent}" />
      <child link="${prefix}torch_link" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <link name="${prefix}torch_tcp" />

    <joint name="${prefix}torch_tcp_joint" type="fixed">
      <parent link="${prefix}torch_link" />
      <child link="${prefix}torch_tcp" />
      <origin xyz="${tcp_xyz}" rpy="${tcp_rpy}" />
    </joint>

  </xacro:macro>

</robot>

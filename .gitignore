# Python bytecode cache
__pycache__/
*.pyc

# Colcon / ROS build artifacts (if ever built in-tree)
build/
install/
log/

# VAMP Phase-2 collision engine venv (ADR-0005) — local build, do not commit
tamp_core/.venv_vamp/

# generated pipeline outputs (multi_robot_cell_tamp) — persistent but not committed
tamp_core/artifacts/**/*.json
tamp_core/artifacts/*.json
tamp_core/artifacts/**/*.npz
# plans archived with save_as: the scene YAML and meshes are copied next to the JSONs
tamp_core/artifacts/runs/

# SIMD mu kernel (ADR-0005 Phase 2b) — compiled with -march=native, so it is a LOCAL
# build artifact and not portable across CPUs. Rebuild with scripts/build_mu_kernel.sh.
tamp_core/lib/*.so

# VAMP source clone and package backups made by vamp_codegen/build_vamp.sh
tamp_core/vamp_codegen/.vamp_src/
tamp_core/vamp_codegen/.vamp_backup_*/

# cross-repo: cloned by vcs from dependencies.repos (CNR-STIIMA-IRAS/tiago_cell)
/tiago_cell/

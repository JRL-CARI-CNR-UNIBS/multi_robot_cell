<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>multi_robot_cell_tamp</name>
  <version>0.0.1</version>
  <description>
    Offline stage of the multi-robot TAMP pipeline: plans one trajectory per
    (robot, task) pair, resamples them onto a uniform time step shared by both
    robots, and (next) computes the inter-robot collision matrices. Writes an
    artifact that the Python scheduler consumes -- the artifact file IS the
    geometry-free seam, so no solver code lives here and no geometry crosses into
    the solver. See CONTEXT.md and docs/adr/.
  </description>
  <maintainer email="igattidiclaude@gmail.com">riccardo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>
  <depend>moveit_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_eigen</depend>
  <depend>yaml_cpp_vendor</depend>

  <!-- schedule_executor.py + scene_visualizer.py (rclpy) -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <!-- scene_visualizer.py: publishes CollisionObject/AttachedCollisionObject and
       reads config/tamp_task.yaml. moveit_msgs is a <depend> above (build+exec). -->
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
